bool priceInDemand = false

//---------------------------------------------------------------------
// NEAREST SUPPLY
//---------------------------------------------------------------------

if array.size(supplyZones) > 0

    for i = 0 to array.size(supplyZones) - 1

        box currentSupply = array.get(
             supplyZones,
             i
        )

        float zoneTop = box.get_top(
             currentSupply
        )

        float zoneBottom = box.get_bottom(
             currentSupply
        )

        bool insideSupply = (
             close >= zoneBottom and
             close <= zoneTop
        )

        if insideSupply

            priceInSupply := true

            nearestSupplyTop := zoneTop
            nearestSupplyBottom := zoneBottom
            nearestSupplyDistance := 0.0

        else if zoneBottom > close

            float supplyDistance = (
                 zoneBottom -
                 close
            )

            if (
                 na(nearestSupplyDistance) or
                 supplyDistance <
                 nearestSupplyDistance
            )

                nearestSupplyDistance :=
                     supplyDistance

                nearestSupplyTop :=
                     zoneTop

                nearestSupplyBottom :=
                     zoneBottom

//---------------------------------------------------------------------
// NEAREST DEMAND
//---------------------------------------------------------------------

if array.size(demandZones) > 0

    for i = 0 to array.size(demandZones) - 1

        box currentDemand = array.get(
             demandZones,
             i
        )

        float zoneTop = box.get_top(
             currentDemand
        )

        float zoneBottom = box.get_bottom(
             currentDemand
        )

        bool insideDemand = (
             close >= zoneBottom and
             close <= zoneTop
        )

        if insideDemand

            priceInDemand := true

            nearestDemandTop := zoneTop
            nearestDemandBottom := zoneBottom
            nearestDemandDistance := 0.0

        else if zoneTop < close

            float demandDistance = (
                 close -
                 zoneTop
            )

            if (
                 na(nearestDemandDistance) or
                 demandDistance <
                 nearestDemandDistance
            )

                nearestDemandDistance :=
                     demandDistance

                nearestDemandTop :=
                     zoneTop

                nearestDemandBottom :=
                     zoneBottom

//=====================================================================
// 23. ZONE STATUS
//=====================================================================

string zoneStatus = "BETWEEN ZONES"

if priceInSupply

    zoneStatus := "AT SUPPLY"

else if priceInDemand

    zoneStatus := "AT DEMAND"

else if (
     na(nearestSupplyDistance) and
     na(nearestDemandDistance)
)

    zoneStatus := "NO ACTIVE ZONES"

//=====================================================================
// 24. SIGNAL FILTERS
//=====================================================================

fiveMinuteOK = (
     not onlyFiveMinute or
     (
          timeframe.isminutes and
          timeframe.multiplier == 5
     )
)

callAMDOK = (
     not requireAMD or
     amdScore >= 20
)

putAMDOK = (
     not requireAMD or
     amdScore <= -20
)

callSOXXOK = (
     not requireSOXX or
     soxxScore >= 20
)

putSOXXOK = (
     not requireSOXX or
     soxxScore <= -20
)

callVWAPOK = (
     not requireVWAP or
     priceAboveVWAP
)

putVWAPOK = (
     not requireVWAP or
     priceBelowVWAP
)

callEMAOK = (
     not requireEMA or
     emaBullish
)

putEMAOK = (
     not requireEMA or
     emaBearish
)

adxOK = (
     not requireADX or
     strongTrend
)

volumeOK = (
     not requireVolume or
     strongVolume
)

callLeadershipOK = (
     bullCount >= minimumConfirmations and
     leadershipScore > 0
)

putLeadershipOK = (
     bearCount >= minimumConfirmations and
     leadershipScore < 0
)

// Avoid entering directly inside opposing zone.

callZoneOK = (
     not priceInSupply
)

putZoneOK = (
     not priceInDemand
)

//=====================================================================
// 25. CALL / PUT SETUPS
//=====================================================================

callSetup = (
     fiveMinuteOK and
     confidence >= callThreshold and
     callAMDOK and
     callSOXXOK and
     callVWAPOK and
     callEMAOK and
     adxOK and
     volumeOK and
     callLeadershipOK and
     callZoneOK
)

putSetup = (
     fiveMinuteOK and
     confidence <= putThreshold and
     putAMDOK and
     putSOXXOK and
     putVWAPOK and
     putEMAOK and
     adxOK and
     volumeOK and
     putLeadershipOK and
     putZoneOK
)

strongCallSetup = (
     callSetup and
     confidence >= strongCallThreshold
)

strongPutSetup = (
     putSetup and
     confidence <= strongPutThreshold
)

callWatch = (
     not callSetup and
     confidence >= callWatchThreshold
)

putWatch = (
     not putSetup and
     confidence <= putWatchThreshold
)

//=====================================================================
// 26. SIGNAL COOLDOWN
//=====================================================================

var int lastSignalBar = na

cooldownOK = (
     na(lastSignalBar) or
     bar_index - lastSignalBar >= cooldownBars
)

previousCallSetup = (
     bar_index > 0
     ? callSetup[1]
     : false
)

previousPutSetup = (
     bar_index > 0
     ? putSetup[1]
     : false
)

callSignal = (
     barstate.isconfirmed and
     callSetup and
     not previousCallSetup and
     cooldownOK
)

putSignal = (
     barstate.isconfirmed and
     putSetup and
     not previousPutSetup and
     cooldownOK
)

if (
     callSignal or
     putSignal
)

    lastSignalBar :=
         bar_index

//=====================================================================
// 27. MARKET STATUS
//=====================================================================

string marketStatus = "WAIT"

if strongCallSetup

    marketStatus := "STRONG CALL"

else if callSetup

    marketStatus := "CALL"

else if strongPutSetup

    marketStatus := "STRONG PUT"

else if putSetup

    marketStatus := "PUT"

else if callWatch

    marketStatus := "CALL WATCH"

else if putWatch

    marketStatus := "PUT WATCH"

//=====================================================================
// 28. ENTRY / STOP / TARGETS
//=====================================================================

bullishPlan = (
     overallSignedScore >= 0
)

referenceEntry = close

referenceStop = (
     bullishPlan
     ? referenceEntry - atrValue * stopATR
     : referenceEntry + atrValue * stopATR
)

referenceTarget1 = (
     bullishPlan
     ? referenceEntry + atrValue * target1ATR
     : referenceEntry - atrValue * target1ATR
)

referenceTarget2 = (
     bullishPlan
     ? referenceEntry + atrValue * target2ATR
     : referenceEntry - atrValue * target2ATR
)

riskDistance = math.abs(
     referenceEntry -
     referenceStop
)

rewardDistance = math.abs(
     referenceTarget2 -
     referenceEntry
)

rewardRisk = (
     riskDistance > 0
     ? rewardDistance / riskDistance
     : 0.0
)

