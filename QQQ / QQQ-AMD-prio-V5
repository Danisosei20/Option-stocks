//=====================================================================
// 8. HELPER FUNCTIONS
//=====================================================================

clampSigned(float value) =>
    math.max(
         -100.0,
         math.min(100.0, value)
    )

clampConfidence(float value) =>
    math.max(
         0.0,
         math.min(100.0, value)
    )

directionText(float score) =>
    string result = "NEUTRAL"

    if score >= 20
        result := "BULLISH"
    else if score <= -20
        result := "BEARISH"

    result

confirmationScore() =>
    float localEMA9 = ta.ema(
         close,
         emaFastLength
    )

    float localEMA21 = ta.ema(
         close,
         emaSlowLength
    )

    float localEMA50 = ta.ema(
         close,
         emaTrendLength
    )

    float localVWAP = ta.vwap(hlc3)

    float localRSI = ta.rsi(
         close,
         rsiLength
    )

    float localMACDFast = ta.ema(
         close,
         macdFastLength
    )

    float localMACDSlow = ta.ema(
         close,
         macdSlowLength
    )

    float localMACDLine = (
         localMACDFast -
         localMACDSlow
    )

    float localMACDSignal = ta.ema(
         localMACDLine,
         macdSignalLength
    )

    float localHistogram = (
         localMACDLine -
         localMACDSignal
    )

    float score = 0.0

    if localEMA9 > localEMA21
        score += 20
    else if localEMA9 < localEMA21
        score -= 20

    if close > localEMA50
        score += 20
    else if close < localEMA50
        score -= 20

    if close > localVWAP
        score += 20
    else if close < localVWAP
        score -= 20

    if localRSI >= 55
        score += 20
    else if localRSI <= 45
        score -= 20

    if localHistogram > 0
        score += 20
    else if localHistogram < 0
        score -= 20

    clampSigned(score)

zoneExistsNear(
     array<box> zones,
     float newCenter,
     float minimumDistance
) =>
    bool found = false

    if array.size(zones) > 0
        for i = 0 to array.size(zones) - 1

            box existingZone = array.get(
                 zones,
                 i
            )

            float existingCenter = (
                 box.get_top(existingZone) +
                 box.get_bottom(existingZone)
            ) / 2.0

            if (
                 math.abs(
                      existingCenter -
                      newCenter
                 ) <= minimumDistance
            )
                found := true

    found

//=====================================================================
// 9. QQQ TECHNICALS
//=====================================================================

ema9 = ta.ema(
     close,
     emaFastLength
)

ema21 = ta.ema(
     close,
     emaSlowLength
)

ema50 = ta.ema(
     close,
     emaTrendLength
)

sessionVWAP = ta.vwap(hlc3)

rsiValue = ta.rsi(
     close,
     rsiLength
)

macdFast = ta.ema(
     close,
     macdFastLength
)

macdSlow = ta.ema(
     close,
     macdSlowLength
)

macdLine = (
     macdFast -
     macdSlow
)

macdSignal = ta.ema(
     macdLine,
     macdSignalLength
)

macdHistogram = (
     macdLine -
     macdSignal
)

[plusDI, minusDI, adxValue] = ta.dmi(
     dmiLength,
     adxSmoothing
)

atrValue = ta.atr(
     atrLength
)

averageVolume = ta.sma(
     volume,
     volumeLength
)

relativeVolume = (
     averageVolume > 0
     ? volume / averageVolume
     : 0.0
)

priceAboveVWAP = (
     close > sessionVWAP
)

priceBelowVWAP = (
     close < sessionVWAP
)

emaBullish = (
     ema9 > ema21 and
     close > ema9 and
     close > ema50
)

emaBearish = (
     ema9 < ema21 and
     close < ema9 and
     close < ema50
)

macdBullish = (
     macdHistogram > 0 and
     macdHistogram >= macdHistogram[1]
)

macdBearish = (
     macdHistogram < 0 and
     macdHistogram <= macdHistogram[1]
)

strongTrend = (
     adxValue >= minimumADX
)

strongVolume = (
     relativeVolume >=
     minimumRelativeVolume
)

//=====================================================================
// 10. TREND SCORE
//=====================================================================

float trendScore = 0.0

if ema9 > ema21
    trendScore += 25
else if ema9 < ema21
    trendScore -= 25

if close > ema50
    trendScore += 25
else if close < ema50
    trendScore -= 25

if ema50 > ema50[1]
    trendScore += 20
else if ema50 < ema50[1]
    trendScore -= 20

if priceAboveVWAP
    trendScore += 30
else if priceBelowVWAP
    trendScore -= 30

trendScore := clampSigned(
     trendScore
)

//=====================================================================
// 11. MOMENTUM SCORE
//=====================================================================

float momentumScore = 0.0

if rsiValue >= 60
    momentumScore += 35
else if rsiValue >= 52
    momentumScore += 20
else if rsiValue <= 40
    momentumScore -= 35
else if rsiValue <= 48
    momentumScore -= 20

if macdBullish
    momentumScore += 40
else if macdBearish
    momentumScore -= 40

if close > close[1]
    momentumScore += 25
else if close < close[1]
    momentumScore -= 25

momentumScore := clampSigned(
     momentumScore
)

//=====================================================================
// 12. INSTITUTIONAL SCORE
//=====================================================================

float institutionalScore = 0.0

if priceAboveVWAP
    institutionalScore += 50
else if priceBelowVWAP
    institutionalScore -= 50

if (
     strongTrend and
     plusDI > minusDI
)
    institutionalScore += 30

else if (
     strongTrend and
     minusDI > plusDI
)
    institutionalScore -= 30

if (
     strongVolume and
     close > open
)
    institutionalScore += 20

else if (
     strongVolume and
     close < open
)
    institutionalScore -= 20

institutionalScore := clampSigned(
     institutionalScore
)

//=====================================================================
