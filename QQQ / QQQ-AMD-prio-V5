     lookahead = barmerge.lookahead_off
)

vixScore = (
     -rawVixScore
)

//=====================================================================
// 14. LEADERSHIP SCORE
//=====================================================================

totalWeight = (
     weightAMD +
     weightNVDA +
     weightSOXX +
     weightAVGO +
     weightTSM +
     weightMSFT +
     weightAAPL +
     weightAMZN +
     weightMETA +
     weightSPY +
     weightVIX
)

safeWeight = (
     totalWeight > 0
     ? totalWeight
     : 1.0
)

leadershipScore = (
     amdScore * weightAMD +
     nvdaScore * weightNVDA +
     soxxScore * weightSOXX +
     avgoScore * weightAVGO +
     tsmScore * weightTSM +
     msftScore * weightMSFT +
     aaplScore * weightAAPL +
     amznScore * weightAMZN +
     metaScore * weightMETA +
     spyScore * weightSPY +
     vixScore * weightVIX
) / safeWeight

leadershipScore := clampSigned(
     leadershipScore
)

//=====================================================================
// 15. CONFIRMATION COUNTS
//=====================================================================

int bullCount = 0
int bearCount = 0

if amdScore >= 20
    bullCount += 1
else if amdScore <= -20
    bearCount += 1

if nvdaScore >= 20
    bullCount += 1
else if nvdaScore <= -20
    bearCount += 1

if soxxScore >= 20
    bullCount += 1
else if soxxScore <= -20
    bearCount += 1

if avgoScore >= 20
    bullCount += 1
else if avgoScore <= -20
    bearCount += 1

if tsmScore >= 20
    bullCount += 1
else if tsmScore <= -20
    bearCount += 1

if msftScore >= 20
    bullCount += 1
else if msftScore <= -20
    bearCount += 1

if aaplScore >= 20
    bullCount += 1
else if aaplScore <= -20
    bearCount += 1

if amznScore >= 20
    bullCount += 1
else if amznScore <= -20
    bearCount += 1

if metaScore >= 20
    bullCount += 1
else if metaScore <= -20
    bearCount += 1

if spyScore >= 20
    bullCount += 1
else if spyScore <= -20
    bearCount += 1

if vixScore >= 20
    bullCount += 1
else if vixScore <= -20
    bearCount += 1

//=====================================================================
// 16. CONFIDENCE
//=====================================================================

overallSignedScore = (
     trendScore * 0.30 +
     momentumScore * 0.20 +
     leadershipScore * 0.30 +
     institutionalScore * 0.20
)

overallSignedScore := clampSigned(
     overallSignedScore
)

confidence = (
     50.0 +
     overallSignedScore / 2.0
)

confidence := clampConfidence(
     confidence
)

//=====================================================================
// 17. SUPPLY / DEMAND ARRAYS
//=====================================================================

var array<box> supplyZones = array.new_box()
var array<box> demandZones = array.new_box()

supplyPivot = ta.pivothigh(
     high,
     pivotLength,
     pivotLength
)

demandPivot = ta.pivotlow(
     low,
     pivotLength,
     pivotLength
)

pivotATR = (
     atrValue[pivotLength]
)

//=====================================================================
// 18. CREATE SUPPLY ZONE
//=====================================================================

if (
     showZones and
     not na(supplyPivot) and
     not na(pivotATR)
)

    float supplyTop = supplyPivot

    float supplyBottom = (
         supplyTop -
         pivotATR * zoneATRWidth
    )

    float supplyCenter = (
         supplyTop +
         supplyBottom
    ) / 2.0

    bool duplicateSupply = zoneExistsNear(
         supplyZones,
         supplyCenter,
         pivotATR * zoneSpacingATR
    )

    if not duplicateSupply

        box newSupply = box.new(
             left = bar_index - pivotLength,
             top = supplyTop,
             right = bar_index + 1,
             bottom = supplyBottom,
             xloc = xloc.bar_index,
             extend = extend.right,
             bgcolor = color.new(color.red, 92),
             border_color = color.new(color.red, 35),
             border_width = 1,
             text = "SUPPLY ZONE",
             text_color = color.new(color.white, 10),
             text_size = size.small,
             text_halign = text.align_right,
             text_valign = text.align_center
        )

        array.unshift(
             supplyZones,
             newSupply
        )

        if (
             array.size(supplyZones) >
             maxSupplyZones
        )

            box oldSupply = array.pop(
                 supplyZones
            )

            box.delete(
                 oldSupply
            )

//=====================================================================
// 19. CREATE DEMAND ZONE
//=====================================================================

if (
     showZones and
     not na(demandPivot) and
     not na(pivotATR)
)

    float demandBottom = demandPivot

    float demandTop = (
         demandBottom +
         pivotATR * zoneATRWidth
    )

    float demandCenter = (
         demandTop +
         demandBottom
    ) / 2.0

    bool duplicateDemand = zoneExistsNear(
         demandZones,
         demandCenter,
         pivotATR * zoneSpacingATR
    )

    if not duplicateDemand

        box newDemand = box.new(
             left = bar_index - pivotLength,
             top = demandTop,
             right = bar_index + 1,
             bottom = demandBottom,
             xloc = xloc.bar_index,
             extend = extend.right,
             bgcolor = color.new(color.green, 92),
             border_color = color.new(color.green, 35),
             border_width = 1,
             text = "DEMAND ZONE",
             text_color = color.new(color.white, 10),
             text_size = size.small,
             text_halign = text.align_right,
             text_valign = text.align_center
        )

        array.unshift(
             demandZones,
             newDemand
        )

        if (
             array.size(demandZones) >
             maxDemandZones
        )

            box oldDemand = array.pop(
                 demandZones
            )

            box.delete(
                 oldDemand
            )

//=====================================================================
// 20. REMOVE BROKEN SUPPLY
//=====================================================================

if array.size(supplyZones) > 0

    int supplyIndex = (
         array.size(supplyZones) -
         1
    )

    while supplyIndex >= 0

        box currentSupply = array.get(
             supplyZones,
             supplyIndex
        )

        bool supplyBroken = (
             barstate.isconfirmed and
             close > box.get_top(currentSupply)
        )

        if supplyBroken

            box.delete(
                 currentSupply
            )

            array.remove(
                 supplyZones,
                 supplyIndex
            )

        supplyIndex -= 1

//=====================================================================
// 21. REMOVE BROKEN DEMAND
//=====================================================================

if array.size(demandZones) > 0

    int demandIndex = (
         array.size(demandZones) -
         1
    )

    while demandIndex >= 0

        box currentDemand = array.get(
             demandZones,
             demandIndex
        )

        bool demandBroken = (
             barstate.isconfirmed and
             close < box.get_bottom(currentDemand)
        )

        if demandBroken

            box.delete(
                 currentDemand
            )

            array.remove(
                 demandZones,
                 demandIndex
            )

        demandIndex -= 1

