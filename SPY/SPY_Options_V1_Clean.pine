
//@version=6
indicator(
     "SPY Options V1 - Clean",
     shorttitle = "SPY OPTIONS V1",
     overlay = true,
     max_labels_count = 50,
     max_boxes_count = 20
)

//=====================================================================
// 1. CORE SETTINGS
//=====================================================================

groupCore = "1. Core Settings"

emaFastLength = input.int(9, "EMA Fast", minval = 1, group = groupCore)
emaSlowLength = input.int(21, "EMA Slow", minval = 1, group = groupCore)
emaTrendLength = input.int(50, "EMA Trend", minval = 1, group = groupCore)

rsiLength = input.int(14, "RSI Length", minval = 2, group = groupCore)

macdFastLength = input.int(12, "MACD Fast", minval = 1, group = groupCore)
macdSlowLength = input.int(26, "MACD Slow", minval = 2, group = groupCore)
macdSignalLength = input.int(9, "MACD Signal", minval = 1, group = groupCore)

dmiLength = input.int(14, "DMI Length", minval = 2, group = groupCore)
adxSmoothing = input.int(14, "ADX Smoothing", minval = 2, group = groupCore)

minimumADX = input.float(
     18.0,
     "Minimum ADX",
     minval = 1.0,
     step = 0.5,
     group = groupCore
)

atrLength = input.int(
     14,
     "ATR Length",
     minval = 1,
     group = groupCore
)

volumeLength = input.int(
     20,
     "Relative Volume Length",
     minval = 2,
     group = groupCore
)

minimumRelativeVolume = input.float(
     0.80,
     "Minimum Relative Volume",
     minval = 0.10,
     step = 0.05,
     group = groupCore
)

//=====================================================================
// 2. CONFIRMATION SYMBOLS
//=====================================================================

groupSymbols = "2. Confirmation Symbols"

symbolQQQ = input.symbol(
     "NASDAQ:QQQ",
     "QQQ",
     group = groupSymbols
)

symbolDIA = input.symbol(
     "AMEX:DIA",
     "DIA",
     group = groupSymbols
)

symbolIWM = input.symbol(
     "AMEX:IWM",
     "IWM",
     group = groupSymbols
)

symbolVIX = input.symbol(
     "CBOE:VIX",
     "VIX",
     group = groupSymbols
)

symbolXLK = input.symbol(
     "AMEX:XLK",
     "XLK",
     group = groupSymbols
)

symbolXLF = input.symbol(
     "AMEX:XLF",
     "XLF",
     group = groupSymbols
)

symbolXLY = input.symbol(
     "AMEX:XLY",
     "XLY",
     group = groupSymbols
)

//=====================================================================
// 3. EXTERNAL CONFIRMATION WEIGHTS
//=====================================================================

groupWeights = "3. Confirmation Weights"

weightQQQ = input.float(
     22.0,
     "QQQ",
     minval = 0,
     group = groupWeights
)

weightDIA = input.float(
     16.0,
     "DIA",
     minval = 0,
     group = groupWeights
)

weightIWM = input.float(
     16.0,
     "IWM",
     minval = 0,
     group = groupWeights
)

weightVIX = input.float(
     18.0,
     "VIX Effect",
     minval = 0,
     group = groupWeights
)

weightXLK = input.float(
     12.0,
     "XLK",
     minval = 0,
     group = groupWeights
)

weightXLF = input.float(
     8.0,
     "XLF",
     minval = 0,
     group = groupWeights
)

weightXLY = input.float(
     8.0,
     "XLY",
     minval = 0,
     group = groupWeights
)

//=====================================================================
// 4. SIGNAL SETTINGS
//=====================================================================

groupSignals = "4. Signal Settings"

strongCallThreshold = input.float(
     85.0,
     "Strong CALL Threshold",
     minval = 50,
     maxval = 100,
     group = groupSignals
)

callThreshold = input.float(
     72.0,
     "CALL Threshold",
     minval = 50,
     maxval = 100,
     group = groupSignals
)

callWatchThreshold = input.float(
     60.0,
     "CALL Watch Threshold",
     minval = 50,
     maxval = 100,
     group = groupSignals
)

putWatchThreshold = input.float(
     40.0,
     "PUT Watch Threshold",
     minval = 0,
     maxval = 50,
     group = groupSignals
)

putThreshold = input.float(
     28.0,
     "PUT Threshold",
     minval = 0,
     maxval = 50,
     group = groupSignals
)

strongPutThreshold = input.float(
     15.0,
     "Strong PUT Threshold",
     minval = 0,
     maxval = 50,
     group = groupSignals
)

minimumConfirmations = input.int(
     4,
     "Minimum External Confirmations",
     minval = 1,
     maxval = 7,
     group = groupSignals
)

cooldownBars = input.int(
     6,
     "Signal Cooldown",
     minval = 1,
     maxval = 100,
     group = groupSignals
)

requireQQQ = input.bool(
     true,
     "Require QQQ",
     group = groupSignals
)

requireVIX = input.bool(
     true,
     "Require VIX Effect",
     group = groupSignals
)

requireVWAP = input.bool(
     true,
     "Require VWAP",
     group = groupSignals
)

requireEMA = input.bool(
     true,
     "Require EMA Alignment",
     group = groupSignals
)

requireADX = input.bool(
     true,
     "Require ADX",
     group = groupSignals
)

requireVolume = input.bool(
     false,
     "Require Relative Volume",
     group = groupSignals
)

onlyFiveMinute = input.bool(
     true,
     "Signals Only on 5-Minute Chart",
     group = groupSignals
)

//=====================================================================
// 5. RISK / TARGET SETTINGS
//=====================================================================

groupRisk = "5. Risk / Targets"

stopATR = input.float(
     1.0,
     "Stop ATR",
     minval = 0.1,
     step = 0.1,
     group = groupRisk
)

target1ATR = input.float(
     1.5,
     "Target 1 ATR",
     minval = 0.1,
     step = 0.1,
     group = groupRisk
)

target2ATR = input.float(
     2.5,
     "Target 2 ATR",
     minval = 0.1,
     step = 0.1,
     group = groupRisk
)

//=====================================================================
// 6. SUPPLY / DEMAND SETTINGS
//=====================================================================

groupZones = "6. Supply / Demand"

showZones = input.bool(
     true,
     "Show Supply / Demand",
     group = groupZones
)

pivotLength = input.int(
     6,
     "Pivot Strength",
     minval = 2,
     maxval = 20,
     group = groupZones
)

zoneATRWidth = input.float(
     0.55,
     "Zone Width ATR",
     minval = 0.10,
     maxval = 2.0,
     step = 0.05,
     group = groupZones
)

zoneSpacingATR = input.float(
     1.25,
     "Minimum Zone Spacing ATR",
     minval = 0.25,
     maxval = 5.0,
     step = 0.25,
     group = groupZones
)

maxSupplyZones = input.int(
     2,
     "Maximum Supply Zones",
     minval = 1,
     maxval = 2,
     group = groupZones
)

maxDemandZones = input.int(
     2,
     "Maximum Demand Zones",
     minval = 1,
     maxval = 2,
     group = groupZones
)

//=====================================================================
// 7. DISPLAY SETTINGS
//=====================================================================

groupDisplay = "7. Display"

showDashboard = input.bool(
     true,
     "Show Dashboard",
     group = groupDisplay
)

showEMA = input.bool(
     true,
     "Show EMA 9 / 21 / 50",
     group = groupDisplay
)

showVWAP = input.bool(
     true,
     "Show VWAP",
     group = groupDisplay
)

showLatestSignal = input.bool(
     true,
     "Show Latest Signal",
     group = groupDisplay
)

showTradeLevels = input.bool(
     false,
     "Show Entry / Stop / Targets",
     group = groupDisplay
)

//=====================================================================
// 8. HELPER FUNCTIONS
//=====================================================================

clampSigned(float value) =>
    math.max(
         -100.0,
         math.min(100.0, value)
    )

clampConfidence(float value) =>
    math.max(
         0.0,
         math.min(100.0, value)
    )

directionText(float score) =>
    string result = "NEUTRAL"

    if score >= 20
        result := "BULLISH"
    else if score <= -20
        result := "BEARISH"

    result

confirmationScore() =>
    float localEMA9 = ta.ema(
         close,
         emaFastLength
    )

    float localEMA21 = ta.ema(
         close,
         emaSlowLength
    )

    float localEMA50 = ta.ema(
         close,
         emaTrendLength
    )

    float localVWAP = ta.vwap(hlc3)

    float localRSI = ta.rsi(
         close,
         rsiLength
    )

    float localMACDFast = ta.ema(
         close,
         macdFastLength
    )

    float localMACDSlow = ta.ema(
         close,
         macdSlowLength
    )

    float localMACDLine = (
         localMACDFast -
         localMACDSlow
    )

    float localMACDSignal = ta.ema(
         localMACDLine,
         macdSignalLength
    )

    float localHistogram = (
         localMACDLine -
         localMACDSignal
    )

    float score = 0.0

    if localEMA9 > localEMA21
        score += 20
    else if localEMA9 < localEMA21
        score -= 20

    if close > localEMA50
        score += 20
    else if close < localEMA50
        score -= 20

    if close > localVWAP
        score += 20
    else if close < localVWAP
        score -= 20

    if localRSI >= 55
        score += 20
    else if localRSI <= 45
        score -= 20

    if localHistogram > 0
        score += 20
    else if localHistogram < 0
        score -= 20

    clampSigned(score)

zoneExistsNear(
     array<box> zones,
     float newCenter,
     float minimumDistance
) =>
    bool found = false

    if array.size(zones) > 0

        for i = 0 to array.size(zones) - 1

            box existingZone = array.get(
                 zones,
                 i
            )

            float existingCenter = (
                 box.get_top(existingZone) +
                 box.get_bottom(existingZone)
            ) / 2.0

            if (
                 math.abs(
                      existingCenter -
                      newCenter
                 ) <= minimumDistance
            )

                found := true

    found

//=====================================================================
// 9. SPY TECHNICALS
//=====================================================================

ema9 = ta.ema(
     close,
     emaFastLength
)

ema21 = ta.ema(
     close,
     emaSlowLength
)

ema50 = ta.ema(
     close,
     emaTrendLength
)

sessionVWAP = ta.vwap(hlc3)

rsiValue = ta.rsi(
     close,
     rsiLength
)

//---------------------------------------------------------------------
// MACD
//---------------------------------------------------------------------

macdFast = ta.ema(
     close,
     macdFastLength
)

macdSlow = ta.ema(
     close,
     macdSlowLength
)

macdLine = (
     macdFast -
     macdSlow
)

macdSignal = ta.ema(
     macdLine,
     macdSignalLength
)

macdHistogram = (
     macdLine -
     macdSignal
)

macdBullish = (
     macdHistogram > 0 and
     macdHistogram >= macdHistogram[1]
)

macdBearish = (
     macdHistogram < 0 and
     macdHistogram <= macdHistogram[1]
)

string macdStatus = "MIXED"

if macdBullish

    macdStatus := "BULLISH"

else if macdBearish

    macdStatus := "BEARISH"

//---------------------------------------------------------------------
// ADX / ATR / VOLUME
//---------------------------------------------------------------------

[plusDI, minusDI, adxValue] = ta.dmi(
     dmiLength,
     adxSmoothing
)

atrValue = ta.atr(
     atrLength
)

averageVolume = ta.sma(
     volume,
     volumeLength
)

relativeVolume = (
     averageVolume > 0
     ? volume / averageVolume
     : 0.0
)

priceAboveVWAP = (
     close > sessionVWAP
)

priceBelowVWAP = (
     close < sessionVWAP
)

emaBullish = (
     ema9 > ema21 and
     close > ema9 and
     close > ema50
)

emaBearish = (
     ema9 < ema21 and
     close < ema9 and
     close < ema50
)

strongTrend = (
     adxValue >= minimumADX
)

strongVolume = (
     relativeVolume >=
     minimumRelativeVolume
)

//=====================================================================
// 10. SPY TREND SCORE
//=====================================================================

float trendScore = 0.0

if ema9 > ema21
    trendScore += 25
else if ema9 < ema21
    trendScore -= 25

if close > ema50
    trendScore += 25
else if close < ema50
    trendScore -= 25

if ema50 > ema50[1]
    trendScore += 20
else if ema50 < ema50[1]
    trendScore -= 20

if priceAboveVWAP
    trendScore += 30
else if priceBelowVWAP
    trendScore -= 30

trendScore := clampSigned(
     trendScore
)

//=====================================================================
// 11. SPY MOMENTUM SCORE
//=====================================================================

float momentumScore = 0.0

if rsiValue >= 60

    momentumScore += 35

else if rsiValue >= 52

    momentumScore += 20

else if rsiValue <= 40

    momentumScore -= 35

else if rsiValue <= 48

    momentumScore -= 20

if macdBullish

    momentumScore += 40

else if macdBearish

    momentumScore -= 40

if close > close[1]

    momentumScore += 25

else if close < close[1]

    momentumScore -= 25

momentumScore := clampSigned(
     momentumScore
)

//=====================================================================
// 12. SPY INSTITUTIONAL / PARTICIPATION
//=====================================================================

float institutionalScore = 0.0

if priceAboveVWAP

    institutionalScore += 45

else if priceBelowVWAP

    institutionalScore -= 45

if (
     strongTrend and
     plusDI > minusDI
)

    institutionalScore += 30

else if (
     strongTrend and
     minusDI > plusDI
)

    institutionalScore -= 30

if (
     strongVolume and
     close > open
)

    institutionalScore += 25

else if (
     strongVolume and
     close < open
)

    institutionalScore -= 25

institutionalScore := clampSigned(
     institutionalScore
)

//=====================================================================
// 13. EXTERNAL MARKET CONFIRMATIONS
//=====================================================================

qqqScore = request.security(
     symbolQQQ,
     timeframe.period,
     confirmationScore(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

diaScore = request.security(
     symbolDIA,
     timeframe.period,
     confirmationScore(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

iwmScore = request.security(
     symbolIWM,
     timeframe.period,
     confirmationScore(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

rawVixScore = request.security(
     symbolVIX,
     timeframe.period,
     confirmationScore(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

// Rising VIX generally works against SPY.
vixEffectScore = (
     -rawVixScore
)

xlkScore = request.security(
     symbolXLK,
     timeframe.period,
     confirmationScore(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

xlfScore = request.security(
     symbolXLF,
     timeframe.period,
     confirmationScore(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

xlyScore = request.security(
     symbolXLY,
     timeframe.period,
     confirmationScore(),
     gaps = barmerge.gaps_off,
     lookahead = barmerge.lookahead_off
)

//=====================================================================
// 14. EXTERNAL LEADERSHIP SCORE
//=====================================================================

totalWeight = (
     weightQQQ +
     weightDIA +
     weightIWM +
     weightVIX +
     weightXLK +
     weightXLF +
     weightXLY
)

safeWeight = (
     totalWeight > 0
     ? totalWeight
     : 1.0
)

leadershipScore = (
     qqqScore * weightQQQ +
     diaScore * weightDIA +
     iwmScore * weightIWM +
     vixEffectScore * weightVIX +
     xlkScore * weightXLK +
     xlfScore * weightXLF +
     xlyScore * weightXLY
) / safeWeight

leadershipScore := clampSigned(
     leadershipScore
)

//=====================================================================
// 15. EXTERNAL CONFIRMATION COUNTS
//=====================================================================

int bullCount = 0
int bearCount = 0

if qqqScore >= 20
    bullCount += 1
else if qqqScore <= -20
    bearCount += 1

if diaScore >= 20
    bullCount += 1
else if diaScore <= -20
    bearCount += 1

if iwmScore >= 20
    bullCount += 1
else if iwmScore <= -20
    bearCount += 1

if vixEffectScore >= 20
    bullCount += 1
else if vixEffectScore <= -20
    bearCount += 1

if xlkScore >= 20
    bullCount += 1
else if xlkScore <= -20
    bearCount += 1

if xlfScore >= 20
    bullCount += 1
else if xlfScore <= -20
    bearCount += 1

if xlyScore >= 20
    bullCount += 1
else if xlyScore <= -20
    bearCount += 1

//=====================================================================
// 16. SPY CONFIDENCE ENGINE
//=====================================================================

// SPY itself = 75%
// External market = 25%

overallSignedScore = (
     trendScore * 0.35 +
     momentumScore * 0.20 +
     institutionalScore * 0.20 +
     leadershipScore * 0.25
)

overallSignedScore := clampSigned(
     overallSignedScore
)

confidence = (
     50.0 +
     overallSignedScore / 2.0
)

confidence := clampConfidence(
     confidence
)

//=====================================================================
// 17. SUPPLY / DEMAND ARRAYS
//=====================================================================

var array<box> supplyZones = array.new_box()
var array<box> demandZones = array.new_box()

supplyPivot = ta.pivothigh(
     high,
     pivotLength,
     pivotLength
)

demandPivot = ta.pivotlow(
     low,
     pivotLength,
     pivotLength
)

pivotATR = (
     atrValue[pivotLength]
)

//=====================================================================
// 18. CREATE SUPPLY
//=====================================================================

if (
     showZones and
     not na(supplyPivot) and
     not na(pivotATR)
)

    float supplyTop = supplyPivot

    float supplyBottom = (
         supplyTop -
         pivotATR * zoneATRWidth
    )

    float supplyCenter = (
         supplyTop +
         supplyBottom
    ) / 2.0

    bool duplicateSupply = zoneExistsNear(
         supplyZones,
         supplyCenter,
         pivotATR * zoneSpacingATR
    )

    if not duplicateSupply

        box newSupply = box.new(
             left = bar_index - pivotLength,
             top = supplyTop,
             right = bar_index + 1,
             bottom = supplyBottom,
             xloc = xloc.bar_index,
             extend = extend.right,
             bgcolor = color.new(
                  color.red,
                  92
             ),
             border_color = color.new(
                  color.red,
                  35
             ),
             border_width = 1,
             text = "SUPPLY ZONE",
             text_color = color.new(
                  color.white,
                  10
             ),
             text_size = size.small,
             text_halign = text.align_right,
             text_valign = text.align_center
        )

        array.unshift(
             supplyZones,
             newSupply
        )

        if (
             array.size(supplyZones) >
             maxSupplyZones
        )

            box oldSupply = array.pop(
                 supplyZones
            )

            box.delete(
                 oldSupply
            )

//=====================================================================
// 19. CREATE DEMAND
//=====================================================================

if (
     showZones and
     not na(demandPivot) and
     not na(pivotATR)
)

    float demandBottom = demandPivot

    float demandTop = (
         demandBottom +
         pivotATR * zoneATRWidth
    )

    float demandCenter = (
         demandTop +
         demandBottom
    ) / 2.0

    bool duplicateDemand = zoneExistsNear(
         demandZones,
         demandCenter,
         pivotATR * zoneSpacingATR
    )

    if not duplicateDemand

        box newDemand = box.new(
             left = bar_index - pivotLength,
             top = demandTop,
             right = bar_index + 1,
             bottom = demandBottom,
             xloc = xloc.bar_index,
             extend = extend.right,
             bgcolor = color.new(
                  color.green,
                  92
             ),
             border_color = color.new(
                  color.green,
                  35
             ),
             border_width = 1,
             text = "DEMAND ZONE",
             text_color = color.new(
                  color.white,
                  10
             ),
             text_size = size.small,
             text_halign = text.align_right,
             text_valign = text.align_center
        )

        array.unshift(
             demandZones,
             newDemand
        )

        if (
             array.size(demandZones) >
             maxDemandZones
        )

            box oldDemand = array.pop(
                 demandZones
            )

            box.delete(
                 oldDemand
            )

//=====================================================================
// 20. REMOVE BROKEN ZONES
//=====================================================================

if array.size(supplyZones) > 0

    int supplyIndex = (
         array.size(supplyZones) -
         1
    )

    while supplyIndex >= 0

        box currentSupply = array.get(
             supplyZones,
             supplyIndex
        )

        if (
             barstate.isconfirmed and
             close >
             box.get_top(currentSupply)
        )

            box.delete(
                 currentSupply
            )

            array.remove(
                 supplyZones,
                 supplyIndex
            )

        supplyIndex -= 1

if array.size(demandZones) > 0

    int demandIndex = (
         array.size(demandZones) -
         1
    )

    while demandIndex >= 0

        box currentDemand = array.get(
             demandZones,
             demandIndex
        )

        if (
             barstate.isconfirmed and
             close <
             box.get_bottom(currentDemand)
        )

            box.delete(
                 currentDemand
            )

            array.remove(
                 demandZones,
                 demandIndex
            )

        demandIndex -= 1

//=====================================================================
// 21. NEAREST SUPPLY / DEMAND
//=====================================================================

float nearestSupplyTop = na
float nearestSupplyBottom = na
float nearestSupplyDistance = na

float nearestDemandTop = na
float nearestDemandBottom = na
float nearestDemandDistance = na

bool priceInSupply = false
bool priceInDemand = false

//---------------------------------------------------------------------
// SUPPLY
//---------------------------------------------------------------------

if array.size(supplyZones) > 0

    for i = 0 to array.size(supplyZones) - 1

        box currentSupply = array.get(
             supplyZones,
             i
        )

        float zoneTop = box.get_top(
             currentSupply
        )

        float zoneBottom = box.get_bottom(
             currentSupply
        )

        bool insideSupply = (
             close >= zoneBottom and
             close <= zoneTop
        )

        if insideSupply

            priceInSupply := true
            nearestSupplyTop := zoneTop
            nearestSupplyBottom := zoneBottom
            nearestSupplyDistance := 0.0

        else if zoneBottom > close

            float distance = (
                 zoneBottom -
                 close
            )

            if (
                 na(nearestSupplyDistance) or
                 distance <
                 nearestSupplyDistance
            )

                nearestSupplyDistance :=
                     distance

                nearestSupplyTop :=
                     zoneTop

                nearestSupplyBottom :=
                     zoneBottom

//---------------------------------------------------------------------
// DEMAND
//---------------------------------------------------------------------

if array.size(demandZones) > 0

    for i = 0 to array.size(demandZones) - 1

        box currentDemand = array.get(
             demandZones,
             i
        )

        float zoneTop = box.get_top(
             currentDemand
        )

        float zoneBottom = box.get_bottom(
             currentDemand
        )

        bool insideDemand = (
             close >= zoneBottom and
             close <= zoneTop
        )

        if insideDemand

            priceInDemand := true
            nearestDemandTop := zoneTop
            nearestDemandBottom := zoneBottom
            nearestDemandDistance := 0.0

        else if zoneTop < close

            float distance = (
                 close -
                 zoneTop
            )

            if (
                 na(nearestDemandDistance) or
                 distance <
                 nearestDemandDistance
            )

                nearestDemandDistance :=
                     distance

                nearestDemandTop :=
                     zoneTop

                nearestDemandBottom :=
                     zoneBottom

//=====================================================================
// 22. ZONE STATUS
//=====================================================================

string zoneStatus = "BETWEEN ZONES"

if priceInSupply

    zoneStatus := "AT SUPPLY"

else if priceInDemand

    zoneStatus := "AT DEMAND"

else if (
     na(nearestSupplyDistance) and
     na(nearestDemandDistance)
)

    zoneStatus := "NO ACTIVE ZONES"

//=====================================================================
// 23. SIGNAL FILTERS
//=====================================================================

fiveMinuteOK = (
     not onlyFiveMinute or
     (
          timeframe.isminutes and
          timeframe.multiplier == 5
     )
)

callQQQOK = (
     not requireQQQ or
     qqqScore >= 20
)

putQQQOK = (
     not requireQQQ or
     qqqScore <= -20
)

callVIXOK = (
     not requireVIX or
     vixEffectScore >= 20
)

putVIXOK = (
     not requireVIX or
     vixEffectScore <= -20
)

callVWAPOK = (
     not requireVWAP or
     priceAboveVWAP
)

putVWAPOK = (
     not requireVWAP or
     priceBelowVWAP
)

callEMAOK = (
     not requireEMA or
     emaBullish
)

putEMAOK = (
     not requireEMA or
     emaBearish
)

adxOK = (
     not requireADX or
     strongTrend
)

volumeOK = (
     not requireVolume or
     strongVolume
)

callLeadershipOK = (
     bullCount >= minimumConfirmations and
     leadershipScore > 0
)

putLeadershipOK = (
     bearCount >= minimumConfirmations and
     leadershipScore < 0
)

callZoneOK = (
     not priceInSupply
)

putZoneOK = (
     not priceInDemand
)

//=====================================================================
// 24. CALL / PUT SETUPS
//=====================================================================

callSetup = (
     fiveMinuteOK and
     confidence >= callThreshold and
     callQQQOK and
     callVIXOK and
     callVWAPOK and
     callEMAOK and
     adxOK and
     volumeOK and
     callLeadershipOK and
     callZoneOK
)

putSetup = (
     fiveMinuteOK and
     confidence <= putThreshold and
     putQQQOK and
     putVIXOK and
     putVWAPOK and
     putEMAOK and
     adxOK and
     volumeOK and
     putLeadershipOK and
     putZoneOK
)

strongCallSetup = (
     callSetup and
     confidence >=
     strongCallThreshold
)

strongPutSetup = (
     putSetup and
     confidence <=
     strongPutThreshold
)

callWatch = (
     not callSetup and
     confidence >=
     callWatchThreshold
)

putWatch = (
     not putSetup and
     confidence <=
     putWatchThreshold
)

//=====================================================================
// 25. SIGNAL COOLDOWN
//=====================================================================

var int lastSignalBar = na

cooldownOK = (
     na(lastSignalBar) or
     bar_index -
     lastSignalBar >=
     cooldownBars
)

previousCallSetup = (
     bar_index > 0
     ? callSetup[1]
     : false
)

previousPutSetup = (
     bar_index > 0
     ? putSetup[1]
     : false
)

callSignal = (
     barstate.isconfirmed and
     callSetup and
     not previousCallSetup and
     cooldownOK
)

putSignal = (
     barstate.isconfirmed and
     putSetup and
     not previousPutSetup and
     cooldownOK
)

if (
     callSignal or
     putSignal
)

    lastSignalBar :=
         bar_index

//=====================================================================
// 26. MARKET STATUS
//=====================================================================

string marketStatus = "WAIT"

if strongCallSetup

    marketStatus :=
         "STRONG CALL"

else if callSetup

    marketStatus :=
         "CALL"

else if strongPutSetup

    marketStatus :=
         "STRONG PUT"

else if putSetup

    marketStatus :=
         "PUT"

else if callWatch

    marketStatus :=
         "CALL WATCH"

else if putWatch

    marketStatus :=
         "PUT WATCH"

//=====================================================================
// 27. ENTRY / STOP / TARGETS
//=====================================================================

bullishPlan = (
     overallSignedScore >= 0
)

referenceEntry = close

referenceStop = (
     bullishPlan
     ? referenceEntry -
       atrValue * stopATR
     : referenceEntry +
       atrValue * stopATR
)

referenceTarget1 = (
     bullishPlan
     ? referenceEntry +
       atrValue * target1ATR
     : referenceEntry -
       atrValue * target1ATR
)

referenceTarget2 = (
     bullishPlan
     ? referenceEntry +
       atrValue * target2ATR
     : referenceEntry -
       atrValue * target2ATR
)

riskDistance = math.abs(
     referenceEntry -
     referenceStop
)

rewardDistance = math.abs(
     referenceTarget2 -
     referenceEntry
)

rewardRisk = (
     riskDistance > 0
     ? rewardDistance /
       riskDistance
     : 0.0
)

//=====================================================================
// 28. CLEAN CHART
//=====================================================================

plot(
     showEMA ? ema9 : na,
     title = "EMA 9",
     color = color.aqua,
     linewidth = 2
)

plot(
     showEMA ? ema21 : na,
     title = "EMA 21",
     color = color.orange,
     linewidth = 2
)

plot(
     showEMA ? ema50 : na,
     title = "EMA 50",
     color = color.yellow,
     linewidth = 2
)

plot(
     showVWAP
     ? sessionVWAP
     : na,
     title = "VWAP",
     color = color.purple,
     linewidth = 2
)

plot(
     showTradeLevels
     ? referenceEntry
     : na,
     title = "Entry",
     color = color.white,
     linewidth = 1,
     style = plot.style_linebr
)

plot(
     showTradeLevels
     ? referenceStop
     : na,
     title = "Stop",
     color = color.red,
     linewidth = 1,
     style = plot.style_linebr
)

plot(
     showTradeLevels
     ? referenceTarget1
     : na,
     title = "Target 1",
     color = color.green,
     linewidth = 1,
     style = plot.style_linebr
)

plot(
     showTradeLevels
     ? referenceTarget2
     : na,
     title = "Target 2",
     color = color.green,
     linewidth = 1,
     style = plot.style_linebr
)

//=====================================================================
// 29. LATEST SIGNAL ONLY
//=====================================================================

var label latestSignalLabel = na

if (
     callSignal and
     showLatestSignal
)

    if not na(
         latestSignalLabel
    )

        label.delete(
             latestSignalLabel
        )

    latestSignalLabel :=
         label.new(
              bar_index,
              low,
              strongCallSetup
                   ? "STRONG CALL"
                   : "CALL",
              style =
                   label.style_label_up,
              color =
                   color.green,
              textcolor =
                   color.white,
              size =
                   size.normal
         )

if (
     putSignal and
     showLatestSignal
)

    if not na(
         latestSignalLabel
    )

        label.delete(
             latestSignalLabel
        )

    latestSignalLabel :=
         label.new(
              bar_index,
              high,
              strongPutSetup
                   ? "STRONG PUT"
                   : "PUT",
              style =
                   label.style_label_down,
              color =
                   color.red,
              textcolor =
                   color.white,
              size =
                   size.normal
         )

//=====================================================================
// 30. DASHBOARD COLORS
//=====================================================================

color panelBG = color.rgb(
     18,
     22,
     30
)

color panelHeader = color.rgb(
     24,
     29,
     39
)

color panelBorder = color.rgb(
     55,
     62,
     75
)

color bullishText = color.rgb(
     60,
     220,
     100
)

color bearishText = color.rgb(
     255,
     75,
     85
)

color neutralText = color.rgb(
     220,
     220,
     220
)

color warningText = color.rgb(
     255,
     170,
     0
)

color statusBG = panelBG
color statusText = neutralText

if (
     marketStatus == "STRONG CALL" or
     marketStatus == "CALL"
)

    statusBG :=
         color.new(
              color.green,
              20
         )

    statusText :=
         color.white

else if (
     marketStatus == "STRONG PUT" or
     marketStatus == "PUT"
)

    statusBG :=
         color.new(
              color.red,
              20
         )

    statusText :=
         color.white

//=====================================================================
// 31. DASHBOARD
//=====================================================================

var table dash = table.new(
     position.top_right,
     2,
     30,
     bgcolor = panelBG,
     frame_color = panelBorder,
     frame_width = 1,
     border_color = panelBorder,
     border_width = 1
)

if (
     barstate.islast and
     showDashboard
)

    table.clear(
         dash,
         0,
         0,
         1,
         29
    )

    //-------------------------------------------------------------
    // HEADER
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         0,
         "SPY OPTIONS V1",
         bgcolor = panelHeader,
         text_color = color.white
    )

    table.cell(
         dash,
         1,
         0,
         "5 MIN",
         bgcolor = panelHeader,
         text_color = color.white
    )

    //-------------------------------------------------------------
    // STATUS
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         1,
         "MARKET STATUS",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         1,
         marketStatus,
         bgcolor = statusBG,
         text_color = statusText
    )

    //-------------------------------------------------------------
    // CONFIDENCE
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         2,
         "CONFIDENCE",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         2,
         str.tostring(
              confidence,
              "#.0"
         ) + "%",
         bgcolor = panelBG,
         text_color =
              overallSignedScore >= 0
              ? bullishText
              : bearishText
    )

    //-------------------------------------------------------------
    // SPY MODEL
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         3,
         "Trend",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         3,
         str.tostring(
              trendScore,
              "#"
         ),
         bgcolor = panelBG,
         text_color =
              trendScore >= 20
              ? bullishText
              : trendScore <= -20
              ? bearishText
              : neutralText
    )

    table.cell(
         dash,
         0,
         4,
         "Momentum",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         4,
         str.tostring(
              momentumScore,
              "#"
         ),
         bgcolor = panelBG,
         text_color =
              momentumScore >= 20
              ? bullishText
              : momentumScore <= -20
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // MACD
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         5,
         "MACD",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         5,
         macdStatus,
         bgcolor = panelBG,
         text_color =
              macdBullish
              ? bullishText
              : macdBearish
              ? bearishText
              : warningText
    )

    //-------------------------------------------------------------
    // RSI
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         6,
         "RSI",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         6,
         str.tostring(
              rsiValue,
              "#.0"
         ),
         bgcolor = panelBG,
         text_color =
              rsiValue >= 55
              ? bullishText
              : rsiValue <= 45
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // LEADERSHIP
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         7,
         "Leadership",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         7,
         str.tostring(
              leadershipScore,
              "#"
         ),
         bgcolor = panelBG,
         text_color =
              leadershipScore >= 20
              ? bullishText
              : leadershipScore <= -20
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // INSTITUTIONAL
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         8,
         "Institutional",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         8,
         str.tostring(
              institutionalScore,
              "#"
         ),
         bgcolor = panelBG,
         text_color =
              institutionalScore >= 20
              ? bullishText
              : institutionalScore <= -20
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // CONFIRMATIONS
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         9,
         "CONFIRMATIONS",
         bgcolor = panelHeader,
         text_color = color.white
    )

    table.cell(
         dash,
         1,
         9,
         "",
         bgcolor = panelHeader
    )

    //-------------------------------------------------------------
    // QQQ
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         10,
         "QQQ",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         10,
         directionText(
              qqqScore
         ),
         bgcolor = panelBG,
         text_color =
              qqqScore >= 20
              ? bullishText
              : qqqScore <= -20
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // DIA
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         11,
         "DIA",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         11,
         directionText(
              diaScore
         ),
         bgcolor = panelBG,
         text_color =
              diaScore >= 20
              ? bullishText
              : diaScore <= -20
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // IWM
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         12,
         "IWM",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         12,
         directionText(
              iwmScore
         ),
         bgcolor = panelBG,
         text_color =
              iwmScore >= 20
              ? bullishText
              : iwmScore <= -20
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // VIX
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         13,
         "VIX EFFECT",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         13,
         directionText(
              vixEffectScore
         ),
         bgcolor = panelBG,
         text_color =
              vixEffectScore >= 20
              ? bullishText
              : vixEffectScore <= -20
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // XLK
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         14,
         "XLK",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         14,
         directionText(
              xlkScore
         ),
         bgcolor = panelBG,
         text_color =
              xlkScore >= 20
              ? bullishText
              : xlkScore <= -20
              ? bearishText
              : neutralText
    )

    //-------------------------------------------------------------
    // TECHNICALS
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         15,
         "TECHNICALS",
         bgcolor = panelHeader,
         text_color = color.white
    )

    table.cell(
         dash,
         1,
         15,
         "",
         bgcolor = panelHeader
    )

    //-------------------------------------------------------------
    // VWAP
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         16,
         "VWAP",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         16,
         priceAboveVWAP
              ? "ABOVE"
              : "BELOW",
         bgcolor = panelBG,
         text_color =
              priceAboveVWAP
              ? bullishText
              : bearishText
    )

    //-------------------------------------------------------------
    // EMA
    //-------------------------------------------------------------

    string emaStatus = (
         emaBullish
         ? "BULLISH"
         : emaBearish
         ? "BEARISH"
         : "MIXED"
    )

    table.cell(
         dash,
         0,
         17,
         "EMA",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         17,
         emaStatus,
         bgcolor = panelBG,
         text_color =
              emaBullish
              ? bullishText
              : emaBearish
              ? bearishText
              : warningText
    )

    //-------------------------------------------------------------
    // ADX
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         18,
         "ADX",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         18,
         str.tostring(
              adxValue,
              "#.0"
         ) +
         (
              strongTrend
              ? " OK"
              : " LOW"
         ),
         bgcolor = panelBG,
         text_color =
              strongTrend
              ? bullishText
              : warningText
    )

    //-------------------------------------------------------------
    // VOLUME
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         19,
         "Volume",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         19,
         str.tostring(
              relativeVolume,
              "#.00"
         ) + "x",
         bgcolor = panelBG,
         text_color =
              strongVolume
              ? bullishText
              : neutralText
    )

    //-------------------------------------------------------------
    // LEVELS
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         20,
         "LEVELS",
         bgcolor = panelHeader,
         text_color = color.white
    )

    table.cell(
         dash,
         1,
         20,
         "",
         bgcolor = panelHeader
    )

    table.cell(
         dash,
         0,
         21,
         "Entry",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         21,
         str.tostring(
              referenceEntry,
              format.mintick
         ),
         bgcolor = panelBG,
         text_color = color.white
    )

    table.cell(
         dash,
         0,
         22,
         "Stop",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         22,
         str.tostring(
              referenceStop,
              format.mintick
         ),
         bgcolor = panelBG,
         text_color = bearishText
    )

    table.cell(
         dash,
         0,
         23,
         "Target 1",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         23,
         str.tostring(
              referenceTarget1,
              format.mintick
         ),
         bgcolor = panelBG,
         text_color = bullishText
    )

    table.cell(
         dash,
         0,
         24,
         "Target 2",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         24,
         str.tostring(
              referenceTarget2,
              format.mintick
         ),
         bgcolor = panelBG,
         text_color = bullishText
    )

    table.cell(
         dash,
         0,
         25,
         "R / R",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         25,
         str.tostring(
              rewardRisk,
              "#.00"
         ) + " : 1",
         bgcolor = panelBG,
         text_color = color.white
    )

    //-------------------------------------------------------------
    // SUPPLY / DEMAND
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         26,
         "SUPPLY / DEMAND",
         bgcolor = panelHeader,
         text_color = color.white
    )

    table.cell(
         dash,
         1,
         26,
         "",
         bgcolor = panelHeader
    )

    color zoneStatusColor = (
         priceInSupply
         ? bearishText
         : priceInDemand
         ? bullishText
         : warningText
    )

    table.cell(
         dash,
         0,
         27,
         "Status",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         27,
         zoneStatus,
         bgcolor = panelBG,
         text_color = zoneStatusColor
    )

    table.cell(
         dash,
         0,
         28,
         "Nearest Supply",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         28,
         na(nearestSupplyBottom)
              ? "N/A"
              : str.tostring(
                   nearestSupplyBottom,
                   format.mintick
                ),
         bgcolor = panelBG,
         text_color = bearishText
    )

    table.cell(
         dash,
         0,
         29,
         "Nearest Demand",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         29,
         na(nearestDemandTop)
              ? "N/A"
              : str.tostring(
                   nearestDemandTop,
                   format.mintick
                ),
         bgcolor = panelBG,
         text_color = bullishText
    )

//=====================================================================
// 32. ALERTS
//=====================================================================

enteredSupply = (
     barstate.isconfirmed and
     priceInSupply and
     not priceInSupply[1]
)

enteredDemand = (
     barstate.isconfirmed and
     priceInDemand and
     not priceInDemand[1]
)

alertcondition(
     callSignal,
     title = "SPY CALL",
     message = "SPY CALL confirmed."
)

alertcondition(
     putSignal,
     title = "SPY PUT",
     message = "SPY PUT confirmed."
)

alertcondition(
     enteredSupply,
     title = "SPY ENTERED SUPPLY",
     message = "SPY entered supply."
)

alertcondition(
     enteredDemand,
     title = "SPY ENTERED DEMAND",
     message = "SPY entered demand."
)
