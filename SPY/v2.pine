         "DIA",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         10,
         directionText(diaScore),
         bgcolor = panelBG,
         text_color = diaScore >= 20
              ? bullishText
              : diaScore <= -20
              ? bearishText
              : neutralText
    )

    table.cell(
         dash,
         0,
         11,
         "IWM",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         11,
         directionText(iwmScore),
         bgcolor = panelBG,
         text_color = iwmScore >= 20
              ? bullishText
              : iwmScore <= -20
              ? bearishText
              : neutralText
    )

    table.cell(
         dash,
         0,
         12,
         "VIX EFFECT",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         12,
         directionText(vixEffectScore),
         bgcolor = panelBG,
         text_color = vixEffectScore >= 20
              ? bullishText
              : vixEffectScore <= -20
              ? bearishText
              : neutralText
