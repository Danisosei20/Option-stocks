    table.cell(
         dash,
         0,
         13,
         "XLK",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         13,
         directionText(xlkScore),
         bgcolor = panelBG,
         text_color = xlkScore >= 20
              ? bullishText
