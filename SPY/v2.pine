         text_color = neutralText
    )

    table.cell(
         dash,
         0,
         24,
         "PDH / PDL",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         24,
         str.tostring(
              previousDayHigh,
              format.mintick
         ) +
         " / " +
         str.tostring(
              previousDayLow,
              format.mintick
         ),
         bgcolor = panelBG,
         text_color = neutralText
    )

    table.cell(
         dash,
         0,
         25,
         "PMH / PML",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         25,
         (
              na(premarketHigh)
              ? "N/A"
              : str.tostring(
                   premarketHigh,
                   format.mintick
                )
         ) +
         " / " +
         (
              na(premarketLow)
              ? "N/A"
              : str.tostring(
                   premarketLow,
                   format.mintick
                )
         ),
         bgcolor = panelBG,
         text_color = neutralText
    )

    table.cell(
         dash,
         0,
         26,
         "Nearest Block",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         26,
         activeObstacleName,
         bgcolor = panelBG,
         text_color = activeObstacleName == "NONE"
              ? bullishText
              : warningText
    )

    table.cell(
         dash,
         0,
         27,
         "Block Price",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         27,
         na(activeObstaclePrice)
              ? "OPEN"
              : str.tostring(
                   activeObstaclePrice,
                   format.mintick
                ),
         bgcolor = panelBG,
         text_color = neutralText
    )

    table.cell(
         dash,
         0,
         28,
         "Room",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         28,
         na(activeRoomATR)
              ? "OPEN"
              : str.tostring(
                   activeRoomATR,
                   "#.00"
                ) + " ATR",
         bgcolor = panelBG,
         text_color = activeRoomQuality == "LIMITED"
              ? bearishText
              : activeRoomQuality == "EXCELLENT"
              ? bullishText
              : neutralText
    )

    table.cell(
         dash,
         0,
         29,
         "Entry Quality",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         29,
         activeRoomQuality,
         bgcolor = panelBG,
         text_color = activeRoomQuality == "LIMITED"
              ? bearishText
              : activeRoomQuality == "EXCELLENT"
              ? bullishText
              : activeRoomQuality == "GOOD"
              ? bullishText
              : neutralText
    )

    //-------------------------------------------------------------
    // TRADE LEVELS
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         30,
