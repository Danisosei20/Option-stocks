         16,
         pocStatus,
         bgcolor = panelBG,
         text_color = priceAbovePOC
              ? bullishText
              : priceBelowPOC
              ? bearishText
              : warningText
    )

    string emaStatus = (
         emaBullish
         ? "BULLISH"
         : emaBearish
         ? "BEARISH"
         : "MIXED"
    )

    table.cell(
         dash,
         0,
         17,
         "EMA",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         17,
         emaStatus,
         bgcolor = panelBG,
         text_color = emaBullish
              ? bullishText
              : emaBearish
              ? bearishText
              : warningText
    )

    table.cell(
         dash,
         0,
         18,
         "ADX",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         18,
         str.tostring(
              adxValue,
              "#.0"
         ),
         bgcolor = panelBG,
         text_color = strongTrend
              ? bullishText
              : warningText
    )

    table.cell(
         dash,
         0,
         19,
         "Volume",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         19,
         str.tostring(
              relativeVolume,
              "#.00"
         ) + "x",
         bgcolor = panelBG,
         text_color = strongVolume
              ? bullishText
              : neutralText
    )

    //-------------------------------------------------------------
    // LOCATION ENGINE
    //-------------------------------------------------------------

    table.cell(
         dash,
         0,
         20,
         "LOCATION",
         bgcolor = panelHeader,
         text_color = color.white
    )

    table.cell(
         dash,
         1,
         20,
         bullishBias
              ? "CALL SIDE"
              : "PUT SIDE",
         bgcolor = panelHeader,
         text_color = bullishBias
              ? bullishText
              : bearishText
    )

    table.cell(
         dash,
         0,
         21,
         "Opening Range",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
