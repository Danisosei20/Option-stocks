         21,
         openingRangeStatus,
         bgcolor = panelBG,
         text_color = openingRangeStatus == "ABOVE HIGH"
              ? bullishText
              : openingRangeStatus == "BELOW LOW"
              ? bearishText
              : warningText
    )

    table.cell(
         dash,
         0,
         22,
         "OR High",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         22,
         na(openingRangeHigh)
              ? "N/A"
              : str.tostring(
                   openingRangeHigh,
                   format.mintick
                ),
         bgcolor = panelBG,
         text_color = neutralText
    )

    table.cell(
         dash,
         0,
         23,
         "OR Low",
         bgcolor = panelBG,
         text_color = color.silver
    )

    table.cell(
         dash,
         1,
         23,
         na(openingRangeLow)
              ? "N/A"
              : str.tostring(
                   openingRangeLow,
                   format.mintick
                ),
