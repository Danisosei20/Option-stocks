    )

//=====================================================================
// 48. ALERTS
//=====================================================================

enteredSupply = (
     barstate.isconfirmed and
     priceInSupply and
     not priceInSupply[1]
)

enteredDemand = (
     barstate.isconfirmed and
     priceInDemand and
     not priceInDemand[1]
)

crossedAbovePOC = (
     barstate.isconfirmed and
     ta.crossover(
          close,
          pocValue
     )
)

crossedBelowPOC = (
     barstate.isconfirmed and
     ta.crossunder(
          close,
          pocValue
     )
)

breakORHigh = (
     barstate.isconfirmed and
     openingRangeComplete and
     ta.crossover(
          close,
          openingRangeHigh
     )
)

breakORLow = (
     barstate.isconfirmed and
     openingRangeComplete and
     ta.crossunder(
          close,
          openingRangeLow
     )
)

alertcondition(
     callSignal,
     title = "SPY CALL",
     message = "SPY CALL confirmed with location filter."
)

alertcondition(
     putSignal,
     title = "SPY PUT",
     message = "SPY PUT confirmed with location filter."
)

alertcondition(
     callLimitedRoom,
     title = "SPY CALL LIMITED ROOM",
     message = "SPY bullish setup detected, but upside room is limited."
)

alertcondition(
     putLimitedRoom,
     title = "SPY PUT LIMITED ROOM",
     message = "SPY bearish setup detected, but downside room is limited."
)

alertcondition(
     enteredSupply,
     title = "SPY ENTERED SUPPLY",
     message = "SPY entered supply."
)

alertcondition(
     enteredDemand,
     title = "SPY ENTERED DEMAND",
     message = "SPY entered demand."
)

alertcondition(
     crossedAbovePOC,
     title = "SPY ABOVE POC",
     message = "SPY crossed above POC."
)

alertcondition(
     crossedBelowPOC,
     title = "SPY BELOW POC",
     message = "SPY crossed below POC."
)

alertcondition(
     breakORHigh,
     title = "SPY BREAK OR HIGH",
     message = "SPY broke above the Opening Range High."
)

alertcondition(
     breakORLow,
     title = "SPY BREAK OR LOW",
     message = "SPY broke below the Opening Range Low."
)
